root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
[*.html]
indent_style = space
indent_size = 2
[*.{css,scss,less}]
indent_style = space
indent_size = 2
[*.min.{css,js}]
indent_style = ignore
insert_final_newline = ignore
trim_trailing_whitespace = false